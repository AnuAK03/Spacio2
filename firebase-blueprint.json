{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated ParkPool AI user record linked to Firebase Auth UID and role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User full display name",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["driver", "host", "admin"],
          "description": "Assigned platform role"
        },
        "organization": {
          "type": "string",
          "description": "Organization or commuter label",
          "minLength": 1,
          "maxLength": 120
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether Firebase Auth email is verified"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last authenticated sign-in timestamp"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "role",
        "organization",
        "emailVerified",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator grant record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "DriverProfileRecord": {
      "title": "DriverProfileRecord",
      "description": "Persisted driver license and vehicle registration tied to the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "licenseNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "licenseValidTill": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "wheelerCategory": {
          "type": "string",
          "enum": ["two_wheeler", "four_wheeler"]
        },
        "vehicleType": {
          "type": "string",
          "enum": ["two_wheeler", "hatchback", "sedan", "suv"]
        },
        "vehicleModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "plateNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "isEv": {
          "type": "boolean"
        },
        "registeredVehicleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "phone",
        "licenseNumber",
        "licenseValidTill",
        "wheelerCategory",
        "vehicleType",
        "vehicleModel",
        "plateNumber",
        "isEv",
        "registeredVehicleId",
        "verified",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProviderEntityRecord": {
      "title": "ProviderEntityRecord",
      "description": "Persisted provider onboarding record with server/admin-gated verification status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contactName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "contactPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "organizationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "registrationNumber": {
          "type": "string",
          "maxLength": 80
        },
        "providerType": {
          "type": "string",
          "enum": [
            "commercial_operator",
            "mall_office",
            "property_owner",
            "property_manager",
            "apartment_residential"
          ]
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "NOT_SUBMITTED",
            "SUBMITTED",
            "UNDER_REVIEW",
            "NEEDS_MORE_INFORMATION",
            "APPROVED",
            "REJECTED",
            "SUSPENDED",
            "EXPIRED"
          ]
        },
        "reviewerId": {
          "type": "string",
          "maxLength": 128
        },
        "decisionReason": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "contactName",
        "contactEmail",
        "contactPhone",
        "organizationName",
        "providerType",
        "verificationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingEntityRecord": {
      "title": "BookingEntityRecord",
      "description": "Persisted booking record tied to the authenticated driver UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driverUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driverEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "facilityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "spaceCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "held",
            "confirmed",
            "checked-in",
            "occupied",
            "completed",
            "cancelled",
            "expired"
          ]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "pending_order", "paid", "failed", "refunded"]
        },
        "totalAmountInr": {
          "type": "number"
        },
        "startMin": {
          "type": "number"
        },
        "endMin": {
          "type": "number"
        },
        "qrVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "driverUid",
        "driverEmail",
        "spaceId",
        "facilityId",
        "facilityName",
        "spaceCode",
        "status",
        "paymentStatus",
        "totalAmountInr",
        "startMin",
        "endMin",
        "qrVerified",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user accounts and role assignments"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized admin UID registry"
    },
    "/driverProfiles/{userId}": {
      "schema": { "$ref": "#/entities/DriverProfileRecord" },
      "description": "Persisted driver licenses and vehicle profiles keyed by UID"
    },
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/ProviderEntityRecord" },
      "description": "Persisted provider onboarding entities owned by authenticated hosts"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingEntityRecord" },
      "description": "Persisted driver parking reservations and QR verification status"
    }
  }
}
